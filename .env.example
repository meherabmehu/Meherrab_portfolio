# Copy this file to .env for local development (and set the same values
# as Environment Variables in your Vercel project for production).

# --- Database (stores contact-form messages) ---
# Local development: SQLite file via Node's built-in driver. Works out of the
# box, no setup, no extra packages, nothing to install.
DATABASE_URL="file:./dev.db"
#
# Production on Vercel: SQLite files do not persist on serverless hosting.
# Create a free Postgres database (e.g. https://neon.tech, https://supabase.com,
# or Vercel's own Postgres/Storage tab) and paste its connection string here
# instead — the app automatically switches drivers based on this URL's prefix,
# no code changes needed.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin access for the /admin/messages page (view contact submissions) ---
ADMIN_PASSWORD="change-this-password"
